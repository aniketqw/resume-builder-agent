# Copy to .env and fill in. See README.

# --- Groq (LLM: summarize, resumes, planning) ---
GROQ_API_KEY=

# --- TypeSafe / Jev (System One: routing + repo selection) ---
TYPESAFE_API_KEY=
TYPESAFE_BASE_URL=https://api.typesafe.ai

# --- LangSmith (tracing + evals) ---
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=resume-builder-agent
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# --- GitHub (read-only, used by github-mcp-server) ---
# Taken from `gh auth token`. Replace with your own PAT to run against another account.
GITHUB_PERSONAL_ACCESS_TOKEN=
GITHUB_USERNAME=aniketqw
