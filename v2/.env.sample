# Copy to .env and fill in. See README.

# --- LLM provider for summarize/build/plan: "groq" (default) or "ollama" ---
# Ollama removes Groq's 8,000 TPM free-tier rate limit entirely by using a
# self-hosted model instead -- see trace.md Iteration 15 for why this exists.
LLM_PROVIDER=groq
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:14b-instruct

# --- Groq (LLM: summarize, resumes, planning) ---
GROQ_API_KEY=

# --- TypeSafe / Jev (System One: routing + repo selection) ---
TYPESAFE_API_KEY=
TYPESAFE_BASE_URL=https://api.typesafe.ai

# --- LangSmith (tracing + evals) ---
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=resume-builder-agent
LANGSMITH_ENDPOINT=https://api.smith.langchain.com

# --- GitHub (read-only, used by github-mcp-server) ---
# Taken from `gh auth token`. Replace with your own PAT to run against another account.
GITHUB_PERSONAL_ACCESS_TOKEN=
GITHUB_USERNAME=aniketqw
